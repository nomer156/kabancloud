@echo off
chcp 65001 > nul
title KabanCloud • Уфанет

:: ==============================================================================
:: УФАНЕТ • Ярлык запуска канбан-доски с автоматической авторизацией по имени ПК
:: Скопируйте этот файл на рабочий стол инженера или распространите через GPO
:: ==============================================================================

:: Замените IP_ИЛИ_ДОМЕН_VPS на реальный IP адрес вашего VPS сервера
set SERVER_URL=http://your-vps-ip:3000

echo Подключение к корпоративной доске KabanCloud...
echo Ваше рабочее место (ПК): %COMPUTERNAME%

:: Открытие в браузере по умолчанию с передачей имени ПК
start "" "%SERVER_URL%/?pc=%COMPUTERNAME%"

exit
